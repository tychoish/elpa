;;; magit-dash-gh-pr-status.el --- Next-step status for your open PRs -*- lexical-binding: t -*-

;; Author: tycho garen
;; Maintainer: tychoish
;; Version: 0.1
;; Package-Requires: ((emacs "29.1") (magit "3.0"))
;; Keywords: vc, tools, magit, github
;; URL: https://github.com/tychoish/dot-emacs

;; This file is not part of GNU Emacs

;;; Commentary:

;; Collects the state of the author's open pull requests in a repository
;; with one GraphQL query, classifies each into a next-step bucket (fix CI,
;; address threads, needs reviews, check merge blockers, ready to merge), and regenerates an org
;; file with a summary table and one TODO per next step.
;;
;; Entry points:
;;   M-x magit-dash-gh-pr-status
;;   emacs --batch -l magit-dash -f magit-dash-gh-pr-status-batch [REPO]
;;   MCP tool `magit_dash_pr_status' (see `magit-dash-mcp')
;;
;; Re-running is idempotent: the summary is rewritten, missing tasks are
;; added, tasks for PRs that are no longer open are marked DONE, and every
;; other task is left exactly as the user edited it.  Tasks are keyed by
;; their :REPO:, :PR: and :STEP: properties, never by heading text.

;;; Code:

(require 'cl-lib)
(require 'map)
(require 'seq)
(require 'subr-x)
(require 'org)
(require 'magit-dash-gh)
(require 'magit-dash-gh-pr)


;;;; Customization

(defgroup magit-dash-gh-pr-status nil
  "Next-step status for the author's open pull requests."
  :group 'magit-dash
  :prefix "magit-dash-gh-pr-status-")

(defcustom magit-dash-gh-pr-status-file "~/org/pr-review-status.org"
  "Org file regenerated by `magit-dash-gh-pr-status'."
  :type 'file)

(defcustom magit-dash-gh-pr-status-required-approvals 1
  "Approvals needed before a PR is classified as ready to merge.
Overridden per repository by `:required-approvals' in the `:pr' plist
of `magit-dash-register'."
  :type 'natnum)

(defcustom magit-dash-gh-pr-status-author "@me"
  "GitHub login whose open PRs are collected; `@me' is the authenticated user."
  :type 'string)

(defcustom magit-dash-gh-pr-status-ignored-reviewers '("claude")
  "Reviewer logins whose reviews never count as approvals.
Reviewers that GitHub reports as bots are always ignored."
  :type '(repeat string))

(defvar magit-dash-gh-pr-status-max-prs 50
  "Number of open PRs requested; there is no pagination beyond this.
GitHub caps the `first' argument of a GraphQL connection at 100.
A response with more results signals an error.")

;;;; Small helpers

(defun magit-dash-gh-pr-status--plural (n)
  "Return the plural suffix for a count of N."
  (if (= n 1) "" "s"))

(defun magit-dash-gh-pr-status--missing-approvals (pr required)
  "Return how many more approvals PR needs to reach REQUIRED."
  (max 0 (- required (plist-get pr :approvals))))

(defun magit-dash-gh-pr-status--file ()
  "Return the expanded path of `magit-dash-gh-pr-status-file'."
  (expand-file-name magit-dash-gh-pr-status-file))

(defun magit-dash-gh-pr-status--read-file ()
  "Return the contents of the status file, or nil when it does not exist."
  (let ((file (magit-dash-gh-pr-status--file)))
    (when (file-exists-p file)
      (with-temp-buffer (insert-file-contents file) (buffer-string)))))

(defun magit-dash-gh-pr-status--one-line (text)
  "Return TEXT with line breaks collapsed to spaces."
  (replace-regexp-in-string "[\n\r]+" " " (or text "")))

(defun magit-dash-gh-pr-status--cell (text)
  "Return TEXT made safe for one org table cell."
  (replace-regexp-in-string
   "|" "\\\\vert{}" (magit-dash-gh-pr-status--one-line text)))

;;;; Collection

(defun magit-dash-gh-pr-status--query ()
  "Return the GraphQL query that fetches every open PR matching a search."
  (format "query($q:String! $first:Int!){
  search(query:$q type:ISSUE first:$first){
    pageInfo{ hasNextPage }
    nodes{
      ... on PullRequest{
        number title url state isDraft headRefName baseRefName
        reviewDecision mergeStateStatus
        reviews(last:100){ pageInfo{ hasPreviousPage } nodes{ state author{ login __typename } } }
        reviewRequests(first:50){
          pageInfo{ hasNextPage }
          nodes{ requestedReviewer{ ... on User{ login } ... on Team{ name } } }
        }
        commits(last:1){
          nodes{ commit{ statusCheckRollup{
            contexts(first:100){
              pageInfo{ hasNextPage }
              nodes{
                __typename
                ... on CheckRun{ name conclusion status detailsUrl }
                ... on StatusContext{ context state targetUrl }
              }
            }
          } } }
        }
        reviewThreads(first:%d){
          pageInfo{ hasNextPage }
          nodes{ isResolved isOutdated }
        }
      }
    }
  }
}" magit-dash-gh-pr-thread-limit))

(defconst magit-dash-gh-pr-status--slug-re
  "\\`[A-Za-z0-9][A-Za-z0-9-]*/\\(?:[A-Za-z0-9_-]\\|\\.[A-Za-z0-9_-]\\|[A-Za-z0-9_-]\\.\\)[A-Za-z0-9_.-]*\\'"
  "Match an owner/name repository slug.
The owner starts with an alphanumeric; the name may not be only dots.")

(defun magit-dash-gh-pr-status--check-slug (slug)
  "Signal `user-error' unless SLUG looks like owner/name."
  (unless (and (stringp slug)
               (string-match-p magit-dash-gh-pr-status--slug-re slug))
    (user-error "Not a GitHub owner/name repository slug: %S" slug)))

(defun magit-dash-gh-pr-status--parse-json (out)
  "Parse OUT as JSON into alists and lists; signal `user-error' if malformed."
  (let ((parsed (condition-case nil
                    (json-parse-string out :object-type 'alist
                                       :array-type 'list :null-object nil)
                  ((json-parse-error json-end-of-file) 'invalid))))
    (when (or (eq parsed 'invalid) (not (listp parsed)))
      (user-error "gh api graphql returned non-JSON output"))
    parsed))

(defun magit-dash-gh-pr-status--fetch (slug dir)
  "Run the PR query for repository SLUG from DIR; return the parsed response.
Signal `user-error' when SLUG is malformed or `gh' fails or returns
something unparseable."
  (magit-dash-gh-pr-status--check-slug slug)
  (pcase-let* ((q (format "repo:%s is:pr is:open author:%s"
                          slug magit-dash-gh-pr-status-author))
               (`(,code . ,out)
                (magit-dash-gh--call-process
                 (list "api" "graphql"
                       "-f" (concat "query=" (magit-dash-gh-pr-status--query))
                       "-f" (concat "q=" q)
                       "-F" (format "first=%d" magit-dash-gh-pr-status-max-prs))
                 dir)))
    (unless (zerop code)
      (user-error "gh api graphql failed (%s): %s" code (string-trim out)))
    (let ((response (magit-dash-gh-pr-status--parse-json out)))
      (when-let* ((errors (map-elt response 'errors)))
        (user-error "GitHub GraphQL error: %s"
                    (mapconcat (lambda (e) (or (map-elt e 'message) "unknown"))
                               errors "; ")))
      (unless (and (map-nested-elt response '(data search))
                   (assq 'nodes (map-nested-elt response '(data search))))
        (user-error "GitHub GraphQL response is missing search results"))
      (when (eq t (map-nested-elt response '(data search pageInfo hasNextPage)))
        (user-error "GitHub returned more PRs than the query limit"))
      (dolist (node (map-nested-elt response '(data search nodes)))
        (when (or (eq t (map-nested-elt node '(reviews pageInfo hasPreviousPage)))
                  (eq t (map-nested-elt node '(reviewRequests pageInfo hasNextPage)))
                  (eq t (map-nested-elt node '(reviewThreads pageInfo hasNextPage)))
                  (eq t (map-nested-elt
                         (car (map-nested-elt node '(commits nodes)))
                         '(commit statusCheckRollup contexts pageInfo hasNextPage))))
          (user-error "GitHub returned incomplete data for PR #%s" (map-elt node 'number))))
      response)))

(defun magit-dash-gh-pr-status--bot-p (author)
  "Return non-nil when review AUTHOR (a GraphQL actor alist) is ignorable."
  (let ((login (or (map-elt author 'login) "")))
    (or (equal (map-elt author '__typename) "Bot")
        (string-suffix-p "[bot]" login)
        (member login magit-dash-gh-pr-status-ignored-reviewers))))

(defun magit-dash-gh-pr-status--latest-states (reviews)
  "Return the latest decisive review state of each human in REVIEWS.
REVIEWS is a chronological list of review nodes.  Anything but COMMENTED
or PENDING is decisive, matching GitHub: a later comment does not retract
an approval."
  (let ((latest (make-hash-table :test #'equal)))
    (dolist (review reviews)
      (let ((author (map-elt review 'author))
            (state (map-elt review 'state)))
        (unless (or (null author)
                    (magit-dash-gh-pr-status--bot-p author)
                    (member state '("COMMENTED" "PENDING")))
          (puthash (map-elt author 'login) state latest))))
    (hash-table-values latest)))

(defun magit-dash-gh-pr-status--approvals (reviews)
  "Count humans in REVIEWS whose latest decisive review is an approval."
  (seq-count (lambda (state) (equal state "APPROVED"))
             (magit-dash-gh-pr-status--latest-states reviews)))

(defun magit-dash-gh-pr-status--changes-requested (reviews)
  "Count humans in REVIEWS whose latest decisive review requests changes."
  (seq-count (lambda (state) (equal state "CHANGES_REQUESTED"))
             (magit-dash-gh-pr-status--latest-states reviews)))

(defun magit-dash-gh-pr-status--context-failing-p (ctx)
  "Return non-nil when the status-check context CTX is failing."
  ;; Reuse the rollup parser on a one-element list so that what counts as a
  ;; failure stays defined in exactly one place.
  (equal (magit-dash-gh-pr--parse-status-rollup (list ctx)) "FAILURE"))

(defun magit-dash-gh-pr-status--failing (contexts)
  "Return (NAME . URL) for each failing check in CONTEXTS."
  (mapcar (lambda (ctx)
            (cons (or (map-elt ctx 'name) (map-elt ctx 'context) "unknown")
                  (or (map-elt ctx 'detailsUrl) (map-elt ctx 'targetUrl))))
          (seq-filter #'magit-dash-gh-pr-status--context-failing-p contexts)))

(defun magit-dash-gh-pr-status--ticket (branch)
  "Return the ticket id such as FND-1269 embedded in BRANCH, or nil."
  (when (and branch (string-match "\\b\\([A-Za-z]+-[0-9]+\\)" branch))
    (upcase (match-string 1 branch))))

(defun magit-dash-gh-pr-status--node-to-pr (node)
  "Convert a GraphQL pull request NODE alist into a PR plist."
  (let* ((rollup (map-nested-elt
                  (car (map-nested-elt node '(commits nodes)))
                  '(commit statusCheckRollup)))
         (contexts (map-nested-elt rollup '(contexts nodes)))
         (threads (map-nested-elt node '(reviewThreads nodes)))
         (reviews (map-nested-elt node '(reviews nodes)))
         (unresolved (seq-remove (lambda (th) (eq (map-elt th 'isResolved) t))
                                 threads)))
    (list :number (map-elt node 'number)
          :title (map-elt node 'title)
          :url (map-elt node 'url)
          :branch (map-elt node 'headRefName)
          :base (map-elt node 'baseRefName)
          :state (map-elt node 'state)
          :draft (eq t (map-elt node 'isDraft))
          :review-decision (let ((d (map-elt node 'reviewDecision)))
                             (and d (not (equal d "")) d))
          :merge-state (map-elt node 'mergeStateStatus)
          :approvals (magit-dash-gh-pr-status--approvals reviews)
          :changes-requested (magit-dash-gh-pr-status--changes-requested reviews)
          :requested (delq nil
                           (mapcar (lambda (rr)
                                     (let ((r (map-elt rr 'requestedReviewer)))
                                       (or (map-elt r 'login) (map-elt r 'name))))
                                   (map-nested-elt node '(reviewRequests nodes))))
          :ci (magit-dash-gh-pr--parse-status-rollup contexts)
          :failing (magit-dash-gh-pr-status--failing contexts)
          :threads-open (seq-count (lambda (th) (not (eq (map-elt th 'isOutdated) t)))
                                   unresolved)
          :threads-outdated (seq-count (lambda (th) (eq (map-elt th 'isOutdated) t))
                                       unresolved)
          :ticket (magit-dash-gh-pr-status--ticket (map-elt node 'headRefName)))))

(defun magit-dash-gh-pr-status--stack-parent (pr prs)
  "Return the number of the PR in PRS whose head branch is PR's base, or nil.
When several PRs share that head branch the first one in PRS wins."
  (when-let* ((base (plist-get pr :base))
              (parent (seq-find (lambda (other)
                                  (and (not (eq other pr))
                                       (equal (plist-get other :branch) base)))
                                prs)))
    (plist-get parent :number)))

(defun magit-dash-gh-pr-status--annotate-stacks (prs)
  "Return PRS with `:stack-parent' set on each stacked PR."
  (mapcar (lambda (pr)
            (plist-put (copy-sequence pr) :stack-parent
                       (magit-dash-gh-pr-status--stack-parent pr prs)))
          prs))

(defun magit-dash-gh-pr-status--annotate-buckets (prs required)
  "Return PRS with `:bucket' set on each PR, given REQUIRED approvals."
  (mapcar (lambda (pr)
            (plist-put (copy-sequence pr) :bucket
                       (magit-dash-gh-pr-status--bucket pr required)))
          prs))

(defun magit-dash-gh-pr-status--parse (response required)
  "Return PR plists, sorted by number, parsed from GraphQL RESPONSE.
REQUIRED is the approval count used to bucket each PR."
  (let* ((nodes (map-nested-elt response '(data search nodes)))
         (prs (mapcar #'magit-dash-gh-pr-status--node-to-pr
                      (seq-filter (lambda (n) (map-elt n 'number)) nodes))))
    (magit-dash-gh-pr-status--annotate-buckets
     (magit-dash-gh-pr-status--annotate-stacks
      (sort prs (lambda (a b) (< (plist-get a :number) (plist-get b :number)))))
     required)))

(defun magit-dash-gh-pr-status--collect (slug dir required)
  "Return PR plists for the author's open PRs in repository SLUG, run from DIR.
REQUIRED is the approval count used to bucket each PR."
  (magit-dash-gh-pr-status--parse
   (magit-dash-gh-pr-status--fetch slug dir) required))

;;;; Classification

(defun magit-dash-gh-pr-status--required-approvals (slug &optional dir)
  "Return the approvals required for repository SLUG.
Fall back to `magit-dash-gh-pr-status-required-approvals' when the
registered value is missing or not a natural number.  DIR identifies the checkout."
  (let ((value (magit-dash-gh-pr-repo-option
                slug :required-approvals
                magit-dash-gh-pr-status-required-approvals dir)))
    (if (natnump value) value magit-dash-gh-pr-status-required-approvals)))

(defun magit-dash-gh-pr-status--bucket (pr required)
  "Classify PR into its next step: `fix-ci', `threads', `reviews', `blocked' or `ready'.
REQUIRED is the approval count needed.  Earlier buckets win, so a PR with a
failing check is never ready.  A PR with requested changes is handled as
`threads' because the next step is to address the feedback."
  (cond
   ((plist-get pr :failing) 'fix-ci)
   ((or (> (plist-get pr :threads-open) 0)
        (> (plist-get pr :changes-requested) 0))
    'threads)
   ((< (plist-get pr :approvals) required) 'reviews)
   ((or (plist-get pr :draft)
        (equal (plist-get pr :ci) "PENDING")
        (member (plist-get pr :merge-state) '("BLOCKED" "DIRTY" "BEHIND" "UNKNOWN" "DRAFT" "UNSTABLE")))
    'blocked)
   (t 'ready)))

(defun magit-dash-gh-pr-status--bucket-label (pr required)
  "Return the summary label for PR given REQUIRED approvals."
  (pcase (plist-get pr :bucket)
    ('fix-ci "fix CI")
    ('threads "address threads")
    ('reviews (let ((missing (magit-dash-gh-pr-status--missing-approvals pr required)))
                (format "needs %d review%s" missing
                        (magit-dash-gh-pr-status--plural missing))))
    ('blocked "check merge blockers")
    ('ready "ready to merge")))

;;;; Rendering

(defun magit-dash-gh-pr-status--format-row (row widths)
  "Pad each cell of ROW to its entry in WIDTHS and join as an org table row."
  (concat "| "
          (string-join
           (cl-mapcar (lambda (cell w)
                        (concat cell (make-string (- w (string-width cell)) ?\s)))
                      row widths)
           " | ")
          " |"))

(defun magit-dash-gh-pr-status--table (rows)
  "Format ROWS, a list of equal-length string lists, as an aligned org table.
The first row is the header."
  (let* ((widths (apply #'cl-mapcar (lambda (&rest cells)
                                      (apply #'max (mapcar #'string-width cells)))
                        rows))
         (rule (concat "|-"
                       (mapconcat (lambda (w) (make-string w ?-)) widths "-+-")
                       "-|")))
    (string-join
     (append (list (magit-dash-gh-pr-status--format-row (car rows) widths) rule)
             (mapcar (lambda (r) (magit-dash-gh-pr-status--format-row r widths))
                     (cdr rows)))
     "\n")))

(defun magit-dash-gh-pr-status--render-summary (prs slug required date)
  "Return the Summary section body for PRS in repository SLUG.
REQUIRED is the approvals needed; DATE is the refresh date string."
  (let* ((rows
          (cons '("PR" "Base" "Ticket" "Approvals" "CI failing" "Unresolved" "Bucket")
                (mapcar
                 (lambda (pr)
                   (mapcar
                    #'magit-dash-gh-pr-status--cell
                    (list (number-to-string (plist-get pr :number))
                          (if-let* ((parent (plist-get pr :stack-parent)))
                              (number-to-string parent)
                            (plist-get pr :base))
                          (plist-get pr :ticket)
                          (format "%d/%d" (plist-get pr :approvals) required)
                          (if-let* ((failing (plist-get pr :failing)))
                              (mapconcat #'car failing ", ")
                            "none")
                          (number-to-string (plist-get pr :threads-open))
                          (magit-dash-gh-pr-status--bucket-label pr required))))
                 prs)))
         (unenforced (mapcar (lambda (pr) (number-to-string (plist-get pr :number)))
                             (seq-remove (lambda (pr) (plist-get pr :review-decision)) prs))))
    (concat
     (format "Refreshed %s for open PRs in %s; %d approval%s required to merge.\n"
             date slug required (magit-dash-gh-pr-status--plural required))
     (when unenforced
       (format "reviewDecision is empty for %s.\n"
               (string-join unenforced ", ")))
     "\n"
     (if prs
         (magit-dash-gh-pr-status--table rows)
       "No open PRs.")
     "\n")))

(defun magit-dash-gh-pr-status--task-heading (pr required)
  "Return the task heading text for PR given REQUIRED approvals."
  (pcase (plist-get pr :bucket)
    ('fix-ci (format "fix %s" (mapconcat (lambda (f)
                                           (magit-dash-gh-pr-status--one-line (car f)))
                                         (plist-get pr :failing) ", ")))
    ('threads
     (let ((open (plist-get pr :threads-open))
           (changes (plist-get pr :changes-requested)))
       (string-join
        (delq nil
              (list (when (> open 0)
                      (format "reply to and resolve %d open thread%s" open
                              (magit-dash-gh-pr-status--plural open)))
                    (when (> changes 0)
                      (format "address changes requested by %d reviewer%s" changes
                              (magit-dash-gh-pr-status--plural changes)))))
        "; ")))
    ('reviews (let ((missing (magit-dash-gh-pr-status--missing-approvals pr required)))
                (format "get %d more approval%s" missing
                        (magit-dash-gh-pr-status--plural missing))))
    ('blocked "check merge blockers")
    ('ready "merge")))

(defun magit-dash-gh-pr-status--task-text (pr slug required)
  "Return the org task entry for PR in repository SLUG."
  (let* ((n (plist-get pr :number))
         (bucket (plist-get pr :bucket))
         (details
          (delq nil
                (list
                 ;; A leading "- " keeps an untrusted title from starting a
                 ;; heading or keyword line.
                 (format "- %s" (magit-dash-gh-pr-status--one-line (plist-get pr :title)))
                 (plist-get pr :url)
                 (when-let* ((parent (plist-get pr :stack-parent)))
                   (format "Stacked on %d; land it first." parent))
                 (when (eq bucket 'fix-ci)
                   (mapconcat (lambda (f)
                                (format "- %s %s"
                                        (magit-dash-gh-pr-status--one-line (car f))
                                        (or (cdr f) "")))
                              (plist-get pr :failing) "\n"))
                 (when (eq bucket 'reviews)
                   (if-let* ((req (plist-get pr :requested)))
                       (format "Requested: %s." (string-join req ", "))
                     "No reviewers requested."))))))
    (format "** TODO %d: %s\n:PROPERTIES:\n:REPO: %s\n:PR: %d\n:STEP: %s\n:END:\n%s\n"
            n (magit-dash-gh-pr-status--task-heading pr required) slug n bucket
            (string-join details "\n"))))

(defconst magit-dash-gh-pr-status--open-keywords
  '("TODO" "INPROGRESS" "BLOCKED" "WAIT" "WAITING" "NEXT" "STARTED")
  "Task keywords that are still open and may be closed when a PR goes away.")

(defun magit-dash-gh-pr-status--heading-re (name)
  "Return a regexp for the top-level heading NAME, tolerating tags and text."
  (format "^\\* %s\\(?:[ \t].*\\)?$" (regexp-quote name)))

(defun magit-dash-gh-pr-status--section-bounds (name)
  "Return (BODY-START . END) of the top-level section NAME, or nil.
BODY-START is the line after the heading; END is the next top-level
heading or the end of the buffer.  Does not depend on or move point."
  (save-excursion
    (goto-char (point-min))
    (when (re-search-forward (magit-dash-gh-pr-status--heading-re name) nil t)
      (let ((start (min (1+ (point)) (point-max))))
        (goto-char start)
        (cons start (if (re-search-forward "^\\* " nil t)
                        (match-beginning 0)
                      (point-max)))))))

(defun magit-dash-gh-pr-status--skeleton (author)
  "Return a fresh status file for AUTHOR with Summary and Tasks headings."
  (format "#+title: Open PR status (%s)\n#+filetags: :agent:prs:\n\n* Summary\n\n* Tasks\n"
          author))

(defun magit-dash-gh-pr-status--legacy-p (text)
  "Return non-nil when TEXT is a hand-written file without a Tasks heading."
  (and (string-match-p "[^[:space:]]" text)
       (with-temp-buffer
         (insert text)
         (null (magit-dash-gh-pr-status--section-bounds "Tasks")))))

(defun magit-dash-gh-pr-status--archive (text date)
  "Return TEXT's body demoted under an Archive heading dated DATE."
  (let* ((body (replace-regexp-in-string "\\`\\(?:#\\+.*\\(?:\n\\|\\'\\)\\)+" "" text))
         (body (replace-regexp-in-string "^\\(\\*+\\) " "\\1** " body)))
    (format "\n* Archive\n** Hand-written file before automation (archived %s)\n%s"
            date (string-trim-right body))))

(defun magit-dash-gh-pr-status--replace-section (heading body)
  "Replace the text under top-level HEADING in the current buffer with BODY.
Insert HEADING at the end when missing."
  (if-let* ((bounds (magit-dash-gh-pr-status--section-bounds heading)))
      (progn
        (delete-region (car bounds) (cdr bounds))
        (goto-char (car bounds))
        (insert "\n" body "\n"))
    (goto-char (point-max))
    (insert (format "\n* %s\n\n%s\n" heading body))))

(defun magit-dash-gh-pr-status--task-keys ()
  "Return an alist of ((REPO PR STEP) . POINT) for generated tasks in Tasks."
  (let (keys)
    (save-excursion
      (when-let* ((bounds (magit-dash-gh-pr-status--section-bounds "Tasks")))
        (goto-char (car bounds))
        (while (re-search-forward "^\\*\\* " (cdr bounds) t)
          (let ((repo (org-entry-get (point) "REPO"))
                (pr (org-entry-get (point) "PR"))
                (step (org-entry-get (point) "STEP")))
            (when (and repo pr step)
              (push (cons (list repo (string-to-number pr) step)
                          (line-beginning-position))
                    keys))))))
    keys))

(defun magit-dash-gh-pr-status--close-task (pos date)
  "Mark the open task heading at POS DONE, closed on DATE.
A planning line right after the heading gets the CLOSED stamp appended so
that a following :PROPERTIES: drawer stays attached to the heading."
  (save-excursion
    (goto-char pos)
    (when (looking-at (format "\\*\\* \\(%s\\) "
                              (regexp-opt magit-dash-gh-pr-status--open-keywords)))
      (replace-match "DONE" t t nil 1)
      (end-of-line)
      (let ((planning
             (save-excursion
               (and (zerop (forward-line 1))
                    (looking-at "[ \t]*\\(?:SCHEDULED\\|DEADLINE\\|CLOSED\\):.*$")
                    (cons (match-end 0) (match-string 0))))))
        (cond
         ((null planning) (insert (format "\nCLOSED: [%s]" date)))
         ((string-match-p "CLOSED:" (cdr planning)))
         (t (goto-char (car planning))
            (insert (format " CLOSED: [%s]" date))))))))

(defun magit-dash-gh-pr-status--close-vanished-tasks (keys open-numbers slug date)
  "Mark DONE the tasks in KEYS for SLUG whose PR is not in OPEN-NUMBERS.
KEYS is as returned by `magit-dash-gh-pr-status--task-keys'; DATE is the
closing date.  Nothing is closed when OPEN-NUMBERS is empty or the result
may be a truncated page, since an empty or full response can be wrong
\(auth, index lag) and absence then proves nothing."
  (when (and open-numbers
             (< (length open-numbers) magit-dash-gh-pr-status-max-prs))
    ;; Close from the bottom so earlier positions stay valid.
    (dolist (entry (sort (copy-sequence keys) (lambda (a b) (> (cdr a) (cdr b)))))
      (pcase-let ((`((,repo ,pr ,_) . ,pos) entry))
        (when (and (equal repo slug) (not (memq pr open-numbers)))
          (magit-dash-gh-pr-status--close-task pos date))))))

(defun magit-dash-gh-pr-status--append-tasks (prs slug required keys)
  "Append a task to Tasks for each PR in PRS in SLUG whose key is not in KEYS."
  (let ((new (delq nil
                   (mapcar
                    (lambda (pr)
                      (let ((key (list slug (plist-get pr :number)
                                       (symbol-name (plist-get pr :bucket)))))
                        (unless (assoc key keys)
                          (magit-dash-gh-pr-status--task-text pr slug required))))
                    prs))))
    (when new
      (goto-char (cdr (magit-dash-gh-pr-status--section-bounds "Tasks")))
      (unless (bolp) (insert "\n"))
      (insert (string-join new "")))))

(defun magit-dash-gh-pr-status--merge-tasks (prs slug required date)
  "Merge tasks for PRS in repository SLUG into the current buffer.
Insert tasks whose key is missing and close tasks whose PR is absent from PRS.
Existing tasks are never rewritten.  REQUIRED and DATE are as for the summary."
  (let ((keys (magit-dash-gh-pr-status--task-keys)))
    (magit-dash-gh-pr-status--close-vanished-tasks
     keys (mapcar (lambda (pr) (plist-get pr :number)) prs) slug date)
    (magit-dash-gh-pr-status--append-tasks prs slug required keys)))

(defun magit-dash-gh-pr-status--render (existing prs slug required date)
  "Return the status file text for PRS in SLUG merged into EXISTING.
EXISTING is the current file text or nil.  REQUIRED is the approvals needed
and DATE the refresh date.  Pure: touches no files."
  (let ((existing (or existing "")))
    (with-temp-buffer
      (delay-mode-hooks (org-mode))
      (insert
       (cond
        ((string-empty-p (string-trim existing))
         (magit-dash-gh-pr-status--skeleton magit-dash-gh-pr-status-author))
        ((magit-dash-gh-pr-status--legacy-p existing)
         (concat (magit-dash-gh-pr-status--skeleton magit-dash-gh-pr-status-author)
                 (magit-dash-gh-pr-status--archive existing date)
                 "\n"))
        (t existing)))
      (magit-dash-gh-pr-status--replace-section
       "Summary" (magit-dash-gh-pr-status--render-summary prs slug required date))
      (magit-dash-gh-pr-status--merge-tasks prs slug required date)
      (buffer-string))))

;;;; Entry points

(defun magit-dash-gh-pr-status--check-unsaved ()
  "Signal `user-error' when the status file is open with unsaved changes."
  (let ((buf (find-buffer-visiting (magit-dash-gh-pr-status--file))))
    (when (and buf (buffer-modified-p buf))
      (user-error "Save %s before regenerating it" (buffer-name buf)))))

(defun magit-dash-gh-pr-status--write (text)
  "Atomically write TEXT to the status file and refresh any visiting buffer."
  (let* ((file (file-truename (magit-dash-gh-pr-status--file)))
         (dir (file-name-directory file))
         (modes (and (file-exists-p file) (file-modes file)))
         (tmp nil))
    (make-directory dir t)
    ;; Re-check right before writing: collection can take a while.
    (magit-dash-gh-pr-status--check-unsaved)
    (unwind-protect
        (progn
          (setq tmp (make-temp-file (expand-file-name ".pr-status-" dir)))
          (write-region text nil tmp nil 'silent)
          (when modes (set-file-modes tmp modes))
          (rename-file tmp file t)
          (setq tmp nil))
      (when (and tmp (file-exists-p tmp))
        (delete-file tmp)))
    (when-let* ((buf (find-buffer-visiting file)))
      (with-current-buffer buf (revert-buffer t t t)))
    file))

(defun magit-dash-gh-pr-status-run (slug dir)
  "Collect PRs for repository SLUG from DIR and regenerate the status file.
Return a plist with `:file', `:prs' and `:required'."
  (magit-dash-gh-pr-status--check-slug slug)
  (magit-dash-gh-pr-status--check-unsaved)
  (let* ((required (magit-dash-gh-pr-status--required-approvals slug dir))
         (prs (magit-dash-gh-pr-status--collect slug dir required))
         (text (magit-dash-gh-pr-status--render
                (magit-dash-gh-pr-status--read-file) prs slug required
                (format-time-string "%Y-%m-%d %a"))))
    (list :file (magit-dash-gh-pr-status--write text)
          :prs prs
          :required required)))

(defun magit-dash-gh-pr-status--current ()
  "Return (SLUG . DIR) for the repository at point."
  (let* ((dir (magit-dash-gh--repo-dir))
         (info (let ((default-directory dir)) (magit-dash-gh--repo-info))))
    (unless (and (plist-get info :owner) (plist-get info :repo))
      (user-error "Cannot determine the GitHub repository for %s" dir))
    (cons (format "%s/%s" (plist-get info :owner) (plist-get info :repo)) dir)))

;;;###autoload
(defun magit-dash-gh-pr-status ()
  "Regenerate `magit-dash-gh-pr-status-file' for the current repository."
  (interactive)
  (pcase-let* ((`(,slug . ,dir) (magit-dash-gh-pr-status--current))
               (result (magit-dash-gh-pr-status-run slug dir)))
    (message "magit-dash: %d open PR%s in %s -> %s"
             (length (plist-get result :prs))
             (if (= 1 (length (plist-get result :prs))) "" "s")
             slug (plist-get result :file))
    result))

;;;###autoload
(defun magit-dash-gh-pr-status-batch ()
  "Regenerate the status file from `emacs --batch'; exit non-zero on failure.
An optional command-line argument names the repository directory."
  (let ((default-directory (file-name-as-directory
                            (expand-file-name (or (pop command-line-args-left)
                                                  default-directory)))))
    (condition-case err
        (let ((result (pcase-let ((`(,slug . ,dir) (magit-dash-gh-pr-status--current)))
                        (magit-dash-gh-pr-status-run slug dir))))
          (princ (format "%d open PRs -> %s\n"
                         (length (plist-get result :prs)) (plist-get result :file))))
      (error
       (message "magit-dash-gh-pr-status: %s" (error-message-string err))
       (kill-emacs 1)))))

(provide 'magit-dash-gh-pr-status)

