;;; Commentary:

;; Provides automated worktree symlink enforcement and worktree management for `magit-dash'.
;;
;; Features:
;; 1. Global symlink targets shared across all worktrees (`magit-dash-worktree-global-symlinks').
;; 2. Repository-to-symlinks mapping alist (`magit-dash-worktree-repo-symlinks').
;; 3. Per-repository `:worktree-symlinks' field in `magit-dash-register'.
;;
;; When a new worktree is created or checked out, symlinks pointing from the main
;; repository checkout to the linked worktree are automatically established.

;;; Code:

(require 'cl-lib)
(require 'seq)
(require 'subr-x)
(require 'magit-git)
(require 'magit-process)
(require 'magit-worktree)
(require 'magit-dash-gh)

(declare-function asq-worktree-create "agent-shell-queue")
(declare-function asq-worktree-dispatch-task "agent-shell-queue")
(declare-function asq-worktree-generate-name "agent-shell-queue")
(declare-function asq-worktree-git-repo-root "agent-shell-queue")
(declare-function annotated-completing-read "annotated-completing-read")
(declare-function magit-dash-pr-dashboard-open-worktree "magit-dash-pr")
(declare-function magit-dash-pr-dashboard--current-repo-slug "magit-dash-pr")
(declare-function magit-dash-pr-create-all-worktrees "magit-dash-pr")
(declare-function magit-dash-pr-review-worktrees "magit-dash-pr")
(declare-function magit-dash-pr-delete-worktree "magit-dash-pr")
(declare-function magit-dash-pr-clean-merged-worktrees "magit-dash-pr")


;; Forward declarations for magit-dash core functions and variables
(declare-function magit-dash-repo-name "magit-dash")
(declare-function magit-dash-repo-path "magit-dash")
(declare-function magit-dash-repo-worktree "magit-dash")
(declare-function magit-dash-repo-worktree-symlinks "magit-dash")
(declare-function magit-dash--repo-at-point "magit-dash")
(declare-function magit-dash--resolve-repo-path "magit-dash")
(declare-function magit-dash-refresh "magit-dash")
(defvar magit-dash-repo-list)

;;; Customization

(defgroup magit-dash-worktree nil
  "Worktree symlink and management extensions for `magit-dash'."
  :group 'magit-dash
  :prefix "magit-dash-worktree-")

(defcustom magit-dash-worktree-global-symlinks '("node_modules" ".venv" ".env")
  "List of relative paths to symlink from the main worktree into linked worktrees.
These paths apply globally to all repositories unless overridden or extended."
  :type '(repeat string)
  :group 'magit-dash-worktree)

(defcustom magit-dash-worktree-repo-symlinks nil
  "Alist mapping repository names or paths to lists of relative paths to symlink.
Example:
  \\='((\"my-project\" . (\"dist\" \".env.local\"))
    (\"backend\"    . (\".venv\" \"target\")))"
  :type '(alist :key-type string :value-type (repeat string))
  :group 'magit-dash-worktree)

(defcustom magit-dash-worktree-ignorable-regexps
  '("\\(?:\\`\\|/\\)\\(?:node_modules\\|target\\|__pycache__\\|\\.pytest_cache\\|\\.mypy_cache\\|\\.tox\\|\\.gradle\\)\\(?:/\\|\\'\\)"
    "\\(?:\\`\\|/\\)\\.eslintcache\\'"
    "\\.\\(?:elc\\|eln\\|pyc\\|o\\|class\\)\\'")
  "Regexps for git-ignored paths that are safe to lose with a worktree.
Each is matched against a path relative to the worktree root, as listed by
`git status --ignored' (directories end in a slash).  Ignored files that
match none of these, such as a local `.env' or `keep.secret', make
`magit-dash-worktree-risks' report them.

The default is deliberately short and holds only names that are always
regenerated by a build or package manager.  Directories such as `out',
`build', `dist', `.cache', `.venv' and `.next' are NOT listed: projects
routinely keep results, patches, tokens or local environments there, so
they are flagged.  Add them here only when you know they are disposable in
your repositories."
  :type '(repeat regexp)
  :group 'magit-dash-worktree)

(defcustom magit-dash-worktree-unattended-risk-policy 'refuse
  "What to do when deleting a worktree with risks and no one can be asked.
`refuse' signals a `user-error' listing the risks instead of calling
`yes-or-no-p', which would block an MCP request or answer for nobody.  It
applies in batch mode, in a daemon with no client frame, and whenever
`magit-dash-worktree-unattended' is non-nil (the MCP tools bind it).
`ask' always prompts."
  :type '(choice (const :tag "Refuse and report the risks" refuse)
                 (const :tag "Prompt anyway" ask))
  :group 'magit-dash-worktree)

(defvar magit-dash-worktree-unattended nil
  "Non-nil while a caller, such as an MCP tool, has no user to prompt.")

(defun magit-dash-worktree--unattended-p ()
  "Return non-nil when there is no live user interface to ask a question."
  (or magit-dash-worktree-unattended
      noninteractive
      (not (seq-some (lambda (frame)
                       (not (equal (terminal-name (frame-terminal frame)) "initial_terminal")))
                     (frame-list)))))

(defcustom magit-dash-worktree-auto-symlink t
  "When non-nil, automatically create symlinks in new worktrees.
Hooked via `magit-post-worktree-add-hook'."
  :type 'boolean
  :group 'magit-dash-worktree)

;;; Path resolution & helpers

(defun magit-dash-worktree-main-dir (&optional path)
  "Return the main repository checkout root directory for PATH.
If PATH is in a linked worktree, follows git's common directory back to
the main checkout.  If PATH is nil, uses `default-directory'."
  (let* ((dir (expand-file-name (or path default-directory)))
         (default-directory (file-name-as-directory dir))
         (common-dir (condition-case nil
                         (magit-git-string "rev-parse" "--path-format=absolute" "--git-common-dir")
                       (error nil))))
    (if (and common-dir (not (string-empty-p common-dir)))
        (let ((common-abs (expand-file-name common-dir)))
          (if (string-suffix-p "/.git" common-abs)
              (file-name-directory (directory-file-name common-abs))
            (file-name-directory (directory-file-name (or (magit-toplevel) dir)))))
      (or (magit-toplevel dir) dir))))

(defun magit-dash-worktree-for-branch (repo-dir branch)
  "Return the path of the worktree (main or linked) of REPO-DIR on BRANCH, or nil."
  (when-let* ((wt (seq-find (lambda (w) (equal (alist-get 'branch w) branch))
                            (magit-dash-gh--git-worktrees repo-dir))))
    (alist-get 'path wt)))

(defun magit-dash-worktree-linked-p (&optional path)
  "Return non-nil if PATH (default `default-directory') is a linked worktree.
Returns nil if PATH is the primary repository checkout or not a git repository."
  (let* ((dir (expand-file-name (or path default-directory)))
         (default-directory (file-name-as-directory dir))
         (top (magit-toplevel dir))
         (main (magit-dash-worktree-main-dir dir)))
    (and top main
         (not (equal (file-name-as-directory (expand-file-name top))
                     (file-name-as-directory (expand-file-name main)))))))

(defun magit-dash-worktree-symlinks-for (repo-or-path)
  "Return the combined, deduplicated list of symlink targets for REPO-OR-PATH.
Combines `magit-dash-worktree-global-symlinks', matching entries from
`magit-dash-worktree-repo-symlinks', and per-repo `:worktree-symlinks' settings."
  (let* ((path (cond
                ((stringp repo-or-path) (expand-file-name repo-or-path))
                ((and repo-or-path (fboundp 'magit-dash-repo-path))
                 (expand-file-name (magit-dash-repo-path repo-or-path)))
                (t default-directory)))
         (repo-name (cond
                     ((and repo-or-path (fboundp 'magit-dash-repo-name) (not (stringp repo-or-path)))
                      (magit-dash-repo-name repo-or-path))
                     ((stringp repo-or-path)
                      (if (bound-and-true-p magit-dash-repo-list)
                          (when-let* ((r (seq-find (lambda (r)
                                                     (or (equal (magit-dash-repo-name r) repo-or-path)
                                                         (equal (expand-file-name (magit-dash-repo-path r)) path)))
                                                   magit-dash-repo-list)))
                            (magit-dash-repo-name r))
                        (file-name-nondirectory (directory-file-name path))))
                     (t nil)))
         (repo-struct (if (and repo-or-path (not (stringp repo-or-path)))
                          repo-or-path
                        (when (bound-and-true-p magit-dash-repo-list)
                          (seq-find (lambda (r)
                                      (or (and repo-name (equal (magit-dash-repo-name r) repo-name))
                                          (equal (expand-file-name (magit-dash-repo-path r)) path)))
                                    magit-dash-repo-list))))
         (struct-links (when (and repo-struct (fboundp 'magit-dash-repo-worktree-symlinks))
                         (magit-dash-repo-worktree-symlinks repo-struct)))
         (map-links (let (found)
                      (dolist (entry magit-dash-worktree-repo-symlinks)
                        (let ((key (car entry))
                              (val (cdr entry)))
                          (when (or (and repo-name (equal key repo-name))
                                    (equal (expand-file-name key) path)
                                    (equal key (file-name-nondirectory (directory-file-name path))))
                            (setq found (append found (if (listp val) val (list val)))))))
                      found))
         (all (append magit-dash-worktree-global-symlinks map-links struct-links)))
    (delete-dups (seq-filter (lambda (s) (and (stringp s) (not (string-empty-p s)))) all))))

;;; Symlink execution

(defun magit-dash-worktree-symlink-worktree (worktree-path &optional main-path symlinks)
  "Create symlinks in WORKTREE-PATH pointing to entries in MAIN-PATH.
If MAIN-PATH is nil, resolves it via `magit-dash-worktree-main-dir'.
If SYMLINKS is nil, resolves via `magit-dash-worktree-symlinks-for'.
Returns an alist of ((TARGET . SOURCE) ...) for created or active symlinks."
  (let* ((wt (expand-file-name worktree-path))
         (main (expand-file-name (or main-path (magit-dash-worktree-main-dir wt))))
         (targets (or symlinks (magit-dash-worktree-symlinks-for (or main wt))))
         (created '()))
    (unless (equal (file-name-as-directory wt) (file-name-as-directory main))
      (dolist (rel targets)
        (let ((src (expand-file-name rel main))
              (dst (expand-file-name rel wt)))
          ;; Only link if the source file or directory exists in the main worktree
          (when (file-exists-p src)
            (let ((parent-dir (file-name-directory (directory-file-name dst))))
              (unless (file-directory-p parent-dir)
                (make-directory parent-dir t)))
            (cond
             ;; If destination is already a symlink pointing to source, record it
             ((and (file-symlink-p dst)
                   (equal (expand-file-name (file-symlink-p dst) (file-name-directory dst))
                          src))
              (push (cons rel src) created))
             ;; If destination does not exist (or is a stale symlink), create symlink
             ((or (not (file-exists-p dst)) (file-symlink-p dst))
              (when (file-symlink-p dst)
                (delete-file dst))
              (condition-case nil
                  (progn
                    (make-symbolic-link src dst t)
                    (push (cons rel src) created))
                (error nil))))))))
    (nreverse created)))

;;;###autoload
(defun magit-dash-worktree-sync-symlinks (&optional path)
  "Enforce worktree symlinks for the worktree at PATH.
Defaults to the repo at point or current buffer.  If invoked on a main
worktree, syncs symlinks for all linked worktrees of that repository."
  (interactive)
  (let* ((target-path (expand-file-name
                       (or path
                           (when (fboundp 'magit-dash--repo-at-point)
                             (when-let* ((repo (ignore-errors (magit-dash--repo-at-point))))
                               (magit-dash-repo-path repo)))
                           default-directory)))
         (is-linked (magit-dash-worktree-linked-p target-path))
         (main-dir (magit-dash-worktree-main-dir target-path)))
    (if is-linked
        (let ((created (magit-dash-worktree-symlink-worktree target-path main-dir)))
          (message "magit-dash-worktree: created %d symlink(s) in %s"
                   (length created) (file-name-nondirectory (directory-file-name target-path)))
          created)
      ;; On main worktree: find all worktrees and sync each
      (let* ((default-directory (file-name-as-directory main-dir))
             (wt-lines (condition-case nil
                           (magit-git-lines "worktree" "list" "--porcelain")
                         (error nil)))
             (count 0))
        (when wt-lines
          (dolist (line wt-lines)
            (when (string-prefix-p "worktree " line)
              (let ((wt-dir (substring line 9)))
                (unless (equal (file-name-as-directory (expand-file-name wt-dir))
                               (file-name-as-directory main-dir))
                  (let ((created (magit-dash-worktree-symlink-worktree wt-dir main-dir)))
                    (setq count (+ count (length created)))))))))
        (message "magit-dash-worktree: synced %d symlink(s) across worktrees of %s"
                 count (file-name-nondirectory (directory-file-name main-dir)))))))

;;; Hook integration

(defun magit-dash-worktree-post-add-hook-function (path &optional _branch)
  "Hook function for `magit-post-worktree-add-hook' to enforce worktree symlinks.
Creates configured symlinks in PATH from the main repository checkout."
  (when magit-dash-worktree-auto-symlink
    (condition-case err
        (let ((created (magit-dash-worktree-symlink-worktree path)))
          (when created
            (message "magit-dash-worktree: linked %d target(s) into %s"
                     (length created) (file-name-nondirectory (directory-file-name path)))))
      (error
       (message "magit-dash-worktree: error creating symlinks in %s: %s"
                path (error-message-string err))))))

;; Automatically register on `magit-post-worktree-add-hook'

;;; Non-interactive worktree creation (MCP / scripting)

(declare-function magit-dash-pr--compute-worktree-path "magit-dash-pr")

(defun magit-dash-worktree--git-ok (dir &rest args)
  "Run git ARGS in DIR; return non-nil on exit 0.  Output is discarded."
  (zerop (apply #'call-process "git" nil nil nil "-C" (expand-file-name dir) args)))

(defun magit-dash-worktree-short-name (branch)
  "Return BRANCH with any leading `<prefix>/' components stripped."
  (file-name-nondirectory (directory-file-name branch)))

(defun magit-dash-worktree-default-base (repo-dir)
  "Return the default base ref for new branches in REPO-DIR.
Prefers origin/HEAD, then local main or master, then HEAD."
  (or (with-temp-buffer
        (when (zerop (call-process "git" nil (list (current-buffer) nil) nil
                                   "-C" (expand-file-name repo-dir)
                                   "symbolic-ref" "--short" "refs/remotes/origin/HEAD"))
          (let ((ref (string-trim (buffer-string))))
            (and (not (string-empty-p ref)) ref))))
      (seq-find (lambda (b)
                  (magit-dash-worktree--git-ok
                   repo-dir "rev-parse" "--verify" "--quiet" (concat "refs/heads/" b)))
                '("main" "master"))
      "HEAD"))

(defun magit-dash-worktree-create (repo-dir wt-path branch &optional base-ref)
  "Create worktree WT-PATH with new BRANCH in REPO-DIR; return the path.
When WT-PATH is nil use the configured worktree layout with the short
name of BRANCH.  When BASE-REF is nil use the repo default branch.
Non-interactive: never visits buffers or prompts.  Signals `user-error'
if BRANCH or WT-PATH already exist."
  (unless (and (stringp branch) (not (string-empty-p (string-trim branch))))
    (user-error "A branch name is required"))
  (require 'magit-dash-pr)
  (let* ((repo-dir (expand-file-name repo-dir))
         (wt-path (expand-file-name
                   (or wt-path
                       (magit-dash-pr--compute-worktree-path
                        repo-dir (magit-dash-worktree-short-name branch)))))
         (base (or base-ref (magit-dash-worktree-default-base repo-dir))))
    (when (magit-dash-worktree--git-ok repo-dir "rev-parse" "--verify" "--quiet"
                                       (concat "refs/heads/" branch))
      (user-error "Branch already exists: %s" branch))
    (when (file-exists-p wt-path)
      (user-error "Worktree path already exists: %s" wt-path))
    (unless (magit-dash-worktree--git-ok repo-dir "rev-parse" "--verify" "--quiet"
                                         (concat base "^{commit}"))
      (user-error "Base ref not found: %s" base))
    (make-directory (file-name-directory (directory-file-name wt-path)) t)
    (let ((out (generate-new-buffer " *magit-dash-worktree-create*")))
      (unwind-protect
          (unless (zerop (call-process "git" nil out nil "-C" repo-dir
                                       "worktree" "add" "--no-track" "-b" branch wt-path base))
            (user-error "Failed to create worktree %s: %s" wt-path
                        (with-current-buffer out (string-trim (buffer-string)))))
        (kill-buffer out)))
    (magit-dash-worktree-post-add-hook-function wt-path branch)
    wt-path))

;;; Interactive worktree commands for dashboard & overview

;;;###autoload
(defun magit-dash-worktree-add ()
  "Add a new worktree for the repository at point via magit."
  (interactive)
  (let ((repo (magit-dash--repo-at-point)))
    (when (magit-dash-repo-worktree repo)
      (user-error "Cannot add a worktree from a worktree entry"))
    (magit-dash-gh--with-repo-dir (magit-dash-repo-path repo)
      (call-interactively #'magit-worktree-checkout))
    (magit-dash-refresh)))

(defconst magit-dash-worktree--status-args
  '("-c" "status.showUntrackedFiles=all" "-c" "status.ignoreSubmodules=none"
    "status" "--porcelain")
  "Arguments for a `git status' that cannot be silenced by user or repo config.")

;;;###autoload
(defun magit-dash-worktree-uncommitted-changes-p (path)
  "Return non-nil if git worktree at PATH has uncommitted changes.
Checks for modified tracked files, staged changes, untracked files and
changed submodules via `git status --porcelain', forcing
`status.showUntrackedFiles=all' and `status.ignoreSubmodules=none' so a
local config cannot hide them."
  (when (and path (file-directory-p path))
    (with-temp-buffer
      (let ((exit (apply #'call-process "git" nil (current-buffer) nil
                         "-C" (expand-file-name path)
                         magit-dash-worktree--status-args)))
        (if (zerop exit)
            (not (string-empty-p (string-trim (buffer-string))))
          t)))))

(defun magit-dash-worktree--git-output (path &rest args)
  "Run git ARGS in PATH; return (EXIT . OUTPUT-STRING)."
  (with-temp-buffer
    (let ((exit (apply #'call-process "git" nil (list (current-buffer) nil) nil
                       "-C" (expand-file-name path) args)))
      (cons exit (string-trim (buffer-string))))))

(defun magit-dash-worktree--count (path &rest rev-list-args)
  "Return the `git rev-list --count' of REV-LIST-ARGS in PATH, or nil on failure."
  (let ((result (apply #'magit-dash-worktree--git-output path "rev-list" "--count" rev-list-args)))
    (when (and (zerop (car result)) (string-match-p "\\`[0-9]+\\'" (cdr result)))
      (string-to-number (cdr result)))))

(defun magit-dash-worktree--unpublished-risk (path pushed-oid)
  "Return a risk string when PATH holds commits that exist on no ref, or nil.
Detached HEAD: commits reachable from no branch, tag or remote.  A branch:
commits ahead of its upstream, or with no upstream, commits on no other
branch, tag or remote.  Nothing is reported when HEAD is PUSHED-OID."
  (let* ((head (cdr (magit-dash-worktree--git-output path "rev-parse" "HEAD")))
         (branch (let ((result (magit-dash-worktree--git-output
                                path "symbolic-ref" "-q" "--short" "HEAD")))
                   (and (zerop (car result)) (cdr result)))))
    (unless (and pushed-oid (equal head pushed-oid))
      (cond
       ((null branch)
        (let ((n (magit-dash-worktree--count
                  path "HEAD" "--not" "--branches" "--tags" "--remotes")))
          (cond
           ((null n) "cannot tell whether the detached HEAD is reachable from any ref")
           ((> n 0) (format "detached HEAD with %d commit(s) reachable from no branch, tag or remote" n)))))
       (t
        (let ((upstream (magit-dash-worktree--git-output
                         path "rev-parse" "--abbrev-ref" "--symbolic-full-name" "@{upstream}")))
          (cond
           ((zerop (car upstream))
            (let ((n (magit-dash-worktree--count path "@{upstream}..HEAD")))
              (cond
               ((null n) (format "cannot compare %s with its upstream" branch))
               ((> n 0) (format "branch %s has %d commit(s) ahead of %s" branch n (cdr upstream))))))
           (t
            (let ((n (magit-dash-worktree--count
                      path "HEAD" "--not" "--remotes" "--tags"
                      (concat "--exclude=" branch) "--branches")))
              (cond
               ((null n) (format "cannot tell whether branch %s has unique commits" branch))
               ((> n 0) (format "branch %s has no upstream and %d commit(s) on no other ref"
                                branch n))))))))))))

(defun magit-dash-worktree--ignored-risk (path)
  "Return a risk string for non-ignorable ignored files in PATH, or nil."
  (let ((result (magit-dash-worktree--git-output
                 path "-c" "status.showUntrackedFiles=normal" "status" "--porcelain" "--ignored")))
    (cond
     ((not (zerop (car result)))
      "cannot list ignored files")
     (t
      (let ((kept (thread-last
                    (split-string (cdr result) "\n" t)
                    (seq-filter (lambda (line) (string-prefix-p "!! " line)))
                    (seq-map (lambda (line) (string-remove-prefix "!! " line)))
                    (seq-remove (lambda (rel)
                                  (or (file-symlink-p (expand-file-name (directory-file-name rel) path))
                                      (seq-some (lambda (re) (string-match-p re rel))
                                                magit-dash-worktree-ignorable-regexps)))))))
        (when kept
          (format "%d ignored file(s) outside build directories (%s)"
                  (length kept) (string-join (seq-take kept 3) ", "))))))))

(defun magit-dash-worktree--hidden-risk (path)
  "Return a risk for assume-unchanged or skip-worktree files in PATH, or nil.
`git status' never reports edits to these, so they must not count as clean."
  (let ((result (magit-dash-worktree--git-output path "ls-files" "-v")))
    (cond
     ((not (zerop (car result)))
      "cannot list files hidden from git status")
     (t
      (let* ((case-fold-search nil)
             (hidden (thread-last
                      (split-string (cdr result) "\n" t)
                      (seq-filter (lambda (line)
                                    (string-match-p "\\`\\(?:[a-z]\\|S\\) " line)))
                      (seq-map (lambda (line) (substring line 2))))))
        (when hidden
          (format "%d file(s) marked assume-unchanged or skip-worktree (%s)"
                  (length hidden) (string-join (seq-take hidden 3) ", "))))))))

(defun magit-dash-worktree--in-progress-risk (path)
  "Return a risk string when PATH has a merge, rebase, pick or revert in progress."
  (let ((result (magit-dash-worktree--git-output path "rev-parse" "--absolute-git-dir")))
    (if (not (zerop (car result)))
        "cannot find the git directory"
      (when-let* ((found (seq-find (lambda (name)
                                     (file-exists-p (expand-file-name name (cdr result))))
                                   '("MERGE_HEAD" "rebase-merge" "rebase-apply"
                                     "CHERRY_PICK_HEAD" "REVERT_HEAD" "sequencer"))))
        (format "an operation is in progress (%s)" found)))))

(defun magit-dash-worktree-risks (path &optional pushed-oid)
  "Return a list of strings naming deletion risks of the worktree at PATH.
These are beyond uncommitted changes: a merge, rebase, cherry-pick or revert
in progress; unpublished commits (see `magit-dash-worktree--unpublished-risk';
none are reported when HEAD is PUSHED-OID); ignored files outside
`magit-dash-worktree-ignorable-regexps'; and files marked assume-unchanged
or skip-worktree, whose edits `git status' cannot see.
Return nil when there are none."
  (when (and path (file-directory-p path))
    (delq nil (list (magit-dash-worktree--in-progress-risk path)
                    (magit-dash-worktree--unpublished-risk path pushed-oid)
                    (magit-dash-worktree--ignored-risk path)
                    (magit-dash-worktree--hidden-risk path)))))

(defun magit-dash-worktree-confirm-risks (path risks)
  "Ask whether to delete the worktree at PATH despite RISKS; return non-nil if yes.
Without a live UI (batch mode or a daemon with no frame, e.g. an MCP call)
nobody can answer, so signal a `user-error' listing the RISKS, per
`magit-dash-worktree-noninteractive-risk-policy'."
  (when (and (eq magit-dash-worktree-unattended-risk-policy 'refuse)
             (magit-dash-worktree--unattended-p))
    (user-error "Not deleting worktree %s: %s (no one to confirm)"
                path (string-join risks "; ")))
  (yes-or-no-p (format "Worktree %s has: %s.  Delete it anyway? "
                       (abbreviate-file-name path) (string-join risks "; "))))

;;;###autoload
(defun magit-dash-worktree-dirty-many (paths)
  "Return an alist (PATH . DIRTY) for the worktrees PATHS, checked concurrently.
DIRTY follows `magit-dash-worktree-uncommitted-changes-p': non-nil for
modified, staged or untracked files, and also when git fails.  All the
`git status' processes run at once, so N worktrees cost about one."
  (let (procs results)
    (dolist (path paths)
      (if (not (and path (file-directory-p path)))
          (push (cons path nil) results)
        (push (cons path (make-process
                          :name "magit-dash-dirty"
                          :buffer (generate-new-buffer " *magit-dash-dirty*" t)
                          :command (append (list "git" "-C" (expand-file-name path))
                                         magit-dash-worktree--status-args)
                          :connection-type 'pipe :noquery t :sentinel #'ignore))
              procs)))
    (while (seq-some #'process-live-p (mapcar #'cdr procs))
      (accept-process-output nil 0.005))
    (dolist (entry procs)
      (let ((proc (cdr entry)))
        (push (cons (car entry)
                    (or (not (zerop (process-exit-status proc)))
                        (with-current-buffer (process-buffer proc)
                          (not (string-empty-p (string-trim (buffer-string)))))))
              results)
        (kill-buffer (process-buffer proc))))
    (mapcar (lambda (path) (assoc path results)) paths)))

;;;###autoload
(defun magit-dash-worktree-delete ()
  "Delete the worktree at point after checking it for deletion risks.
Signals `user-error' when the current row is not a worktree, when it has
uncommitted changes, or unless the risks listed by
`magit-dash-worktree-risks' (unpublished commits, ignored files outside
build directories, ...) are explicitly confirmed.  The branch is kept."
  (interactive)
  (let ((repo (magit-dash--repo-at-point)))
    (unless (magit-dash-repo-worktree repo)
      (user-error "Not a worktree row; use 'k' only on worktree entries"))
    (require 'magit-dash-pr)
    (magit-dash-pr-delete-worktree (magit-dash-repo-path repo))
    (magit-dash-refresh)))

;;;###autoload
(defun magit-dash-worktree-dispatch (&optional dir)
  "Create an agent worktree under DIR and dispatch a task.
Prompts for task prompt, worktree short name, and target dispatch mode.
Establishes configured symlinks for the new worktree."
  (interactive)
  (let* ((repo-root (or (and (fboundp 'asq-worktree-git-repo-root)
                             (asq-worktree-git-repo-root dir))
                        (magit-dash-worktree-main-dir dir)
                        (user-error "Not in a git repository")))
         (prompt (read-string "Task prompt (empty for worktree only): "))
         (default-name (if (fboundp 'asq-worktree-generate-name)
                          (asq-worktree-generate-name prompt)
                        "worktree"))
         (name (read-string (format "Worktree short name (default %s): " default-name)
                            nil nil default-name))
         (name (if (string-empty-p name) default-name name))
         (choices '(("i: interactive agent-shell" . "Start an interactive agent-shell session")
                    ("q: asq queue" . "Enqueue prompt in directory task queue")
                    ("w: worktree only" . "Create git worktree without dispatching agent task")))
         (mode-choice (if (fboundp 'annotated-completing-read)
                          (annotated-completing-read
                           choices
                           :prompt "Dispatch target: "
                           :require-match t
                           :history 'magit-dash-worktree-dispatch-history)
                        (completing-read "Dispatch target: " '("interactive" "queue" "worktree") nil t)))
         (mode (cond
                ((string-prefix-p "i" mode-choice) "interactive")
                ((string-prefix-p "q" mode-choice) "queue")
                ((string-prefix-p "w" mode-choice) "worktree")
                (t mode-choice)))
         (wt-info (if (fboundp 'asq-worktree-create)
                      (asq-worktree-create :repo-root repo-root :name name :prompt prompt)
                    (let ((path (expand-file-name (concat ".wt/" name) repo-root)))
                      (make-directory (file-name-directory path) t)
                      (call-process "git" nil nil nil "-C" repo-root "worktree" "add" "-b" (concat "wt/" name) path "HEAD")
                      (list :repo-root repo-root :name name :branch (concat "wt/" name) :path path))))
         (wt-path (plist-get wt-info :path)))
    (when wt-path
      (magit-dash-worktree-symlink-worktree wt-path repo-root)
      (if (fboundp 'asq-worktree-dispatch-task)
          (asq-worktree-dispatch-task prompt :target-dir wt-path :mode mode :name name)
        wt-path))))


;;;###autoload
(defun magit-dash-worktree-from-pr (&optional pr-arg repo-dir)
  "Create and open a git worktree from a GitHub pull request.
The worktree directory is created using `magit-dash-pr-worktree-path-format',
and the local branch mirrors the remote branch name.
Interactively, prompts for the PR number or selection in REPO-DIR (defaulting
to the current repository or repository at point)."
  (interactive)
  (require 'magit-dash-pr)
  (let* ((dir (or repo-dir
                  (if (and (fboundp 'magit-dash--repo-at-point-p)
                           (magit-dash--repo-at-point-p))
                      (magit-dash-repo-path (magit-dash--repo-at-point))
                    (or (magit-toplevel) default-directory))))
         (slug (or (ignore-errors
                     (let ((default-directory dir))
                       (magit-dash-pr-dashboard--current-repo-slug)))
                   (file-name-nondirectory (directory-file-name dir))))
         (pr-num
          (cond
           ((integerp pr-arg) pr-arg)
           ((and (stringp pr-arg) (string-match-p "\\`[0-9]+\\'" pr-arg))
            (string-to-number pr-arg))
           (t
            (let* ((candidates
                    (when (executable-find "gh")
                      (ignore-errors
                        (with-temp-buffer
                          (when (zerop (call-process "gh" nil (current-buffer) nil
                                                     "pr" "list" "-R" slug
                                                     "--json" "number,title,headRefName"
                                                     "--template"
                                                     "{{range .}}{{tablerow (printf \"#%v\" .number) .headRefName .title}}{{end}}"))
                            (split-string (string-trim (buffer-string)) "\n" t))))))
                   (choice (if candidates
                               (completing-read (format "PR in %s: " slug) candidates nil nil)
                             (read-string (format "PR number for %s: " slug)))))
              (if (string-match "#?\\([0-9]+\\)" choice)
                  (string-to-number (match-string 1 choice))
                (user-error "Invalid PR number: %s" choice)))))))
    (let ((entry (list :number pr-num :repo slug :pr nil)))
      (magit-dash-pr-dashboard-open-worktree entry))))

;;;###autoload
(defalias 'magit-dash-worktree-checkout-pr #'magit-dash-worktree-from-pr)

